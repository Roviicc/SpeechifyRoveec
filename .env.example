# Google OAuth client ID (Web application) — see README "Google Cloud setup"
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# Browser API key, restricted to the Google Picker API + your origins
VITE_GOOGLE_API_KEY=AIza...
# Optional: Cloud project number (defaults to the numeric prefix of the client ID)
# VITE_GOOGLE_APP_ID=1234567890
# Optional: use the instant silent "fake" voice everywhere (for testing)
# VITE_TTS=fake
